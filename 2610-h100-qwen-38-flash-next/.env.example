# Same keys on both sides; real secrets live only in the ignored .env files.
# - Workstation .env: put secrets/overrides here. scripts/deploy.sh sends only
#   the non-empty lines and merges them into the VM .env.
# - VM .env: created from this file on first deploy; anything not overridden
#   keeps these defaults.

# ngrok agent for compose.ngrok.yaml: an authtoken and a reserved domain from
# your ngrok account, e.g. NGROK_URL=https://<your-domain>.ngrok-free.dev
NGROK_AUTHTOKEN=
NGROK_URL=

# Optional; Qwen checkpoints are public, a token only raises HF rate limits.
HF_TOKEN=

# Pinned checkpoint: Qwen's FP8 (128x128 block scales, 185.6 GB). vLLM keeps
# the 51B n-gram table in pinned host memory, so ~131 GiB of weights sit on
# the two GPUs, 65.6 GiB on each.
MODEL_REPO=Qwen/Qwen3.8-Flash-Next-FP8
MODEL_REVISION=236dfdf285828023ca3bcd3f37366c58a3469b13
MODEL_DIR=Qwen3.8-Flash-Next-FP8

# Model name stamped as upstream_model on every metric, log and span, so runs
# of different models can be told apart. The same name vLLM serves
# (--served-model-name in compose.yaml).
LLM_MODEL=qwen3.8-flash-next-vllm

# vLLM serving defaults for two H100 NVL 94 GB in tensor parallel.
# GPU_MEMORY_UTILIZATION 0.90 leaves ~18 GiB per GPU beside the weights for
# the KV cache, activations and CUDA graphs: 1.5M tokens of FP8 KV cache.
QWEN38_FLASH_NEXT_CONTEXT_SIZE=262144
QWEN38_FLASH_NEXT_GPU_MEMORY_UTILIZATION=0.90
QWEN38_FLASH_NEXT_MAX_NUM_SEQS=32
QWEN38_FLASH_NEXT_MAX_NUM_BATCHED_TOKENS=16384
QWEN38_FLASH_NEXT_SPEC_TOKENS=3

# LiteLLM OpenTelemetry (metadata only; prompts and responses are not captured).
LITELLM_OTEL_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Telemetry overlay (compose.observability.yaml): OTLP to Application
# Insights. Not secrets. Copy the application ID and the three OTLP ingestion
# endpoints from your Application Insights resource. scripts/deploy.sh sets
# TELEMETRY_UAMI_CLIENT_ID from the regional identity attached to the VM
# (id-llm-ingest-<region>, see infra/telemetry-identities.sh).
TELEMETRY_UAMI_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZMON_APPLICATION_ID=00000000-0000-0000-0000-000000000000
AZMON_TRACES_ENDPOINT=https://<dce-name>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Traces/otlp/v1/traces
AZMON_LOGS_ENDPOINT=https://<dce-name>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Logs/otlp/v1/logs
AZMON_METRICS_ENDPOINT=https://<dce-name>.<region>-1.metrics.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OtelMetrics/otlp/v1/metrics
DEPLOYMENT_ENVIRONMENT=azure-h100
