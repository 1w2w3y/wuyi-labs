# Same keys on both sides; real secrets live only in the ignored .env files.
# - Workstation .env: put secrets/overrides here. scripts/deploy.sh sends only
#   the non-empty lines and merges them into the VM .env.
# - VM .env: created from this file on first deploy; anything not overridden
#   keeps these defaults.

# ngrok agent for compose.ngrok.yaml: an authtoken and a reserved domain from
# your ngrok account, e.g. NGROK_URL=https://<your-domain>.ngrok-free.dev
NGROK_AUTHTOKEN=
NGROK_URL=

# Optional; Qwen checkpoints are public, a token only raises HF rate limits.
HF_TOKEN=

# Pinned checkpoint. Official FP8 (30.9 GB, ~29 GiB in GPU memory): decode
# reads ~45% fewer bytes per step than BF16. BF16 baseline (55.6 GB):
#   MODEL_REPO=Qwen/Qwen3.8-27B
#   MODEL_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
#   MODEL_DIR=Qwen3.8-27B
MODEL_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MODEL_DIR=Qwen3.8-27B-FP8

# DFlash 2 block drafter for this model (3.85 GB, 1.86B parameters), fetched
# beside the checkpoint by model-download so QWEN38_27B_SPEC_CONFIG below can
# switch to it without another download. It drafts a whole block of tokens in
# one pass, where the checkpoint's MTP head drafts one token per pass. Leave
# the three keys empty to skip the download.
DRAFT_REPO=incoai/Qwen3.8-27B-DFlash2
DRAFT_REVISION=015e795645c74b1a0eeef3b570031fb62e769bc5
DRAFT_DIR=Qwen3.8-27B-DFlash2

# Model name stamped as upstream_model on every metric, log and span, so runs
# of different models can be told apart. Change it with the model.
LLM_MODEL=qwen3.8-27b

# vLLM serving defaults for one H100 NVL 94 GB.
QWEN38_27B_CONTEXT_SIZE=262144
QWEN38_27B_GPU_MEMORY_UTILIZATION=0.93
QWEN38_27B_MAX_NUM_SEQS=32
QWEN38_27B_MAX_NUM_BATCHED_TOKENS=16384
# The attention block in tokens: vLLM's default. The DFlash drafter needs 64.
QWEN38_27B_BLOCK_SIZE=16
# Speculative decoding, as --speculative-config JSON (single quotes: bash can
# source this file too). The checkpoint's MTP head with three draft tokens is
# the default: the DFlash 2 drafter decodes 20-50% faster for one request but
# 10-12% slower at 16-32 streams, costs 25% of the KV cache and drops the
# prefix-cache hit rate (README.md, "What changed since the post"). For a
# single-user VM, use it instead:
#   QWEN38_27B_SPEC_CONFIG='{"method":"dflash","model":"/models/Qwen3.8-27B-DFlash2","num_speculative_tokens":7,"quantization":"fp8"}'
#   QWEN38_27B_BLOCK_SIZE=64
QWEN38_27B_SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
# --profiler-config; {} is off. scripts/profile-decode-step.sh says what to
# put here for a profiling run.
QWEN38_27B_PROFILER_CONFIG={}

# LiteLLM OpenTelemetry (metadata only; prompts and responses are not captured).
LITELLM_OTEL_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Telemetry overlay (compose.observability.yaml): OTLP to Application
# Insights. Not secrets. Copy the application ID and the three OTLP ingestion
# endpoints from your Application Insights resource. scripts/deploy.sh sets
# TELEMETRY_UAMI_CLIENT_ID from the regional identity attached to the VM
# (id-llm-ingest-<region>, see infra/telemetry-identities.sh).
TELEMETRY_UAMI_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZMON_APPLICATION_ID=00000000-0000-0000-0000-000000000000
AZMON_TRACES_ENDPOINT=https://<dce-name>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Traces/otlp/v1/traces
AZMON_LOGS_ENDPOINT=https://<dce-name>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Logs/otlp/v1/logs
AZMON_METRICS_ENDPOINT=https://<dce-name>.<region>-1.metrics.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OtelMetrics/otlp/v1/metrics
DEPLOYMENT_ENVIRONMENT=azure-h100
