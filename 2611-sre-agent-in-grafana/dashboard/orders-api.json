      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Process uptime",
      "description": "Time since the Node.js process last started. A drop to zero is a restart. Source: the app's Prometheus gauge orders_process_uptime_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_ds}"
          },
          "expr": "max(orders_process_uptime_seconds{job=\"orders-api\"})",
          "legendFormat": "Uptime",
          "range": true,
          "editorMode": "code"
        }
