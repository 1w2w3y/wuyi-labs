{
  "uid": "orders-api",
  "title": "Orders API",
  "tags": [
    "orders-api",
    "app-service",
    "application-insights",
    "prometheus"
  ],
  "description": "Health of the Orders API web app: what callers see (Application Insights), what the platform sees (Azure Monitor metrics), what the app says about itself (Prometheus) and what the logs say (Log Analytics).",
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Process start",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom_ds}"
        },
        "enable": true,
        "iconColor": "#1F60C4",
        "expr": "max(orders_process_uptime_seconds{job=\"orders-api\"}) < 75",
        "step": "60s",
        "titleFormat": "Process started",
        "textFormat": "The Node.js process started (restart or deployment)."
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "am_ds",
        "label": "Azure Monitor",
        "type": "datasource",
        "query": "grafana-azure-monitor-datasource",
        "current": {
          "text": "Azure Monitor",
          "value": "azure-monitor"
        },
        "hide": 2
      },
      {
        "name": "prom_ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Orders API Prometheus",
          "value": "orders-api-prometheus"
        },
        "hide": 2
      },
      {
        "name": "sub",
        "label": "Subscription",
        "type": "constant",
        "query": "<subscription-id>",
        "current": {
          "text": "<subscription-id>",
          "value": "<subscription-id>"
        },
        "hide": 2
      },
      {
        "name": "rg",
        "label": "Resource group",
        "type": "constant",
        "query": "orders-api-demo-rg",
        "current": {
          "text": "orders-api-demo-rg",
          "value": "orders-api-demo-rg"
        },
        "hide": 2
      },
      {
        "name": "region",
        "label": "Region",
        "type": "constant",
        "query": "westus3",
        "current": {
          "text": "westus3",
          "value": "westus3"
        },
        "hide": 2
      },
      {
        "name": "app",
        "label": "Web app",
        "type": "constant",
        "query": "<web-app-name>",
        "current": {
          "text": "<web-app-name>",
          "value": "<web-app-name>"
        },
        "hide": 2
      },
      {
        "name": "plan",
        "label": "App Service plan",
        "type": "constant",
        "query": "orders-api-plan",
        "current": {
          "text": "orders-api-plan",
          "value": "orders-api-plan"
        },
        "hide": 2
      },
      {
        "name": "insights",
        "label": "Application Insights",
        "type": "constant",
        "query": "orders-api-insights",
        "current": {
          "text": "orders-api-insights",
          "value": "orders-api-insights"
        },
        "hide": 2
      },
      {
        "name": "workspace",
        "label": "Log Analytics workspace",
        "type": "constant",
        "query": "orders-api-logs",
        "current": {
          "text": "orders-api-logs",
          "value": "orders-api-logs"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lookup success rate",
      "description": "Share of order lookups that returned a success code, per minute. Source: Application Insights requests.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "requests\n| where $__timeFilter(timestamp)\n| where url has \"/api/orders/\"\n| where timestamp < bin(now(), 1m)\n| summarize ['Success rate'] = 100.0 * countif(success == true) / count() by bin(timestamp, 1m)\n| order by timestamp asc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$insights"
            ],
            "resultFormat": "time_series",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#FA6400",
                "value": 95
              },
              {
                "color": "#37872D",
                "value": 99
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lookup time (P95)",
      "description": "P95 server-side duration of order lookups, per minute. A lookup that runs past 1.5 s fails with HTTP 503. Source: Application Insights requests.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "requests\n| where $__timeFilter(timestamp)\n| where url has \"/api/orders/\"\n| where timestamp < bin(now(), 1m)\n| summarize P95 = percentile(duration, 95) by bin(timestamp, 1m)\n| order by timestamp asc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/microsoft.insights/components/$insights"
            ],
            "resultFormat": "time_series",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#37872D",
                "value": null
              },
              {
                "color": "#FA6400",
                "value": 500
              },
              {
                "color": "#C4162A",
                "value": 1200
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests per minute",
      "description": "Requests the web app received, from the App Service platform metric Requests. Includes the metrics scraper and health probes.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$sub",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$sub",
                "resourceGroup": "$rg",
                "resourceName": "$app",
                "metricNamespace": "microsoft.web/sites"
              }
            ],
            "metricNamespace": "microsoft.web/sites",
            "metricName": "Requests",
            "aggregation": "Total",
            "timeGrain": "auto",
            "region": "$region",
            "allowedTimeGrainsMs": [
              60000,
              300000,
              900000,
              1800000,
              3600000
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1F60C4",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memory working set",
      "description": "Memory the web app is using, from the App Service platform metric MemoryWorkingSet. The B1 plan has 1.75 GB.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
