    {
      "id": 20,
      "type": "logs",
      "title": "Web app console log",
      "description": "Standard output and error of the Node.js process. The app logs its cache size every 60 lookups and one line for each failed lookup. Source: AppServiceConsoleLogs in the Log Analytics workspace.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppServiceConsoleLogs\n| where $__timeFilter(TimeGenerated)\n| project TimeGenerated, Message = ResultDescription, Level\n| order by TimeGenerated desc\n| take 300",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/Microsoft.OperationalInsights/workspaces/$workspace"
            ],
            "resultFormat": "logs",
            "dashboardTime": false
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 34
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Console errors by kind",
      "description": "Error lines in the console log, grouped by the error name at the start of the message. Source: AppServiceConsoleLogs in the Log Analytics workspace.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${am_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${am_ds}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppServiceConsoleLogs\n| where $__timeFilter(TimeGenerated)\n| where Level =~ \"Error\"\n| extend Kind = extract(@\"^([A-Z][A-Za-z]+):\", 1, ResultDescription)\n| where isnotempty(Kind)\n| summarize Count = count(), ['First seen'] = min(TimeGenerated), ['Last seen'] = max(TimeGenerated), Example = take_any(ResultDescription) by Kind\n| order by Count desc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/$rg/providers/Microsoft.OperationalInsights/workspaces/$workspace"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 34
      }
    }
