# Copy to .env next to compose.yaml. Every value has a working default except
# the observability ones, which compose.observability.yaml requires.

# --- Serving (compose.yaml) --------------------------------------------------
# Where the LiteLLM gateway listens. Keep 127.0.0.1 unless another machine on
# your network runs the agent; then use the laptop's LAN address and restrict
# port 4000 to a trusted subnet in Windows Firewall.
LITELLM_HOST_BIND=127.0.0.1

# Requests vLLM runs at once. 1 kept one coding agent's conversation cached
# and decoding at full speed; measure 2 if your agent sends many small requests.
QWEN38_27B_MAX_NUM_SEQS=1
# QWEN38_27B_CONTEXT_SIZE=262144
# QWEN38_27B_KV_CACHE_BYTES=12616466432
# QWEN38_27B_MAX_NUM_BATCHED_TOKENS=8192
# QWEN38_27B_GPU_MEMORY_UTILIZATION=0.05
# QWEN38_27B_MM_PROCESSOR_CACHE_GB=0.25

# --- Telemetry (compose.observability.yaml) ----------------------------------
# Defaults to the Windows computer name.
# MACHINE_NAME=my-laptop

# From an Application Insights resource with OTLP support turned on: its
# application ID and two of the OTLP ingestion endpoints on its Overview page.
AZMON_APPLICATION_ID=00000000-0000-0000-0000-000000000000
AZMON_TRACES_ENDPOINT=https://<dce-name>.<region>-1.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Traces/otlp/v1/traces
AZMON_METRICS_ENDPOINT=https://<dce-name>.<region>-1.metrics.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OtelMetrics/otlp/v1/metrics

# A Microsoft Entra ID application with the Monitoring Metrics Publisher role
# on that resource's data collection rule. The secret stays in .env, which Git
# ignores.
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<application-client-id>
AZURE_CLIENT_SECRET=<client-secret>

# LiteLLM span content: NO_CONTENT keeps prompts and responses out of the spans.
LITELLM_OTEL_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
